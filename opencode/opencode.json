{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "lsp": true,
  "skills": {
    "paths": [
      "./skills"
    ]
  },
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "plan-agent"
      }
    ],
    "opencode-firecrawl@latest",
    "opencode-notify@latest",
    "opencode-wakatime@latest",
    "opencode-background-agents@latest",
    "opencode-morph-fast-apply@latest"
  ],
  "command": {
    "deepmax": {
      "template": "请立即使用 skill 工具加载 deepmax 技能。加载后，在当前对话的后续所有回复中，持续以 DeepSeek MAX 模式运行——进行最深度的推理分析，不跳过任何推理步骤，主动探索多种方案并自我纠错。",
      "description": "启用 DeepSeek V4 MAX 模式——最大推理深度，用于复杂问题",
      "agent": "plan",
      "model": "opencode-go/deepseek-v4-pro",
      "variant": "max"
    }
  },
  "agent": {
    "plan": {
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "制定计划时：\n1. 充分探索代码库，理解现有架构和模式。\n2. 如有不确定的信息，主动向用户提问澄清。\n3. 制定完整计划后，调用 submit_plan 工具提交用户审阅。\n4. 收到用户反馈后修改计划并重新提交，直至批准。"
    },
    "build": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "general": {
      "model": "opencode-go/deepseek-v4-flash"
    }
  },
  "mcp": {
    "markitdown": {
      "type": "local",
      "command": [
        "uvx",
        "markitdown-mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_CONTEXT7_API_KEY"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["uvx", "mcp-server-git"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    }
  }
}
